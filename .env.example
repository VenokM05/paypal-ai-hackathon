# Copy to .env.local (Next.js) and/or export in your shell (MCP server + scripts).

# PayPal: "mock" (default, runs offline) or "live" (PayPal sandbox REST)
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional LLM (any OpenAI-compatible endpoint). Without a key the app
# falls back to deterministic heuristics and still fully works.
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: SQLite ledger location (default ./data/guardian.db)
# GUARDIAN_DB_PATH=
